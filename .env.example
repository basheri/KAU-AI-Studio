# Copy to .env for local development. In production set these on the server / container.
# Never commit real values.

# --- Public (compiled into the browser bundle; safe to expose) ---
VITE_SUPABASE_URL=https://your-project-host
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- Server only (read inside server functions; never sent to browsers) ---
SUPABASE_URL=https://your-project-host
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI assistance stays off unless both are set (see docs/AI_SETUP.md)
AI_ENABLED=false
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=200

# Web server
PORT=3000

# Database migrations only (scripts/migrate.sh); the postgres user connection string
# DATABASE_URL=postgresql://postgres:password@db-host:5432/postgres
